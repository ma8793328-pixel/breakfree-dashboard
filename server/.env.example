# Copy to server/.env and fill in. Everything here is optional:
# without a .env the app uses safe local defaults and persists generated keys.

# Port for the API (default 4000)
# PORT=4000

# Secret used to sign auth tokens. Set a long random value outside of
# local development. Defaults to a dev-only value when unset.
# JWT_SECRET=change-me-to-a-long-random-string

# Admin bootstrap account (seeded on first boot)
# ADMIN_EMAIL=admin@breakfree.app
# ADMIN_PASSWORD=your-strong-admin-password-here-change-this

# Web Push VAPID keys. If both are set they override the keys generated
# and persisted in server/data/vapid.json. Generate your own pair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Real Stripe payments. Set STRIPE_SECRET_KEY to switch from the simulated
# demo checkout to live Stripe Checkout. Get the key at
# dashboard.stripe.com -> Developers -> API keys.
# STRIPE_SECRET_KEY=sk_live_...

# Webhook signing secret (whsec_...) from the Stripe dashboard endpoint
# pointed at https://<your-host>/api/stripe/webhook. Registers events:
#   checkout.session.completed, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: reuse an existing Stripe Price instead of creating price_data.
# Leave unset to create a $4.99/month "BreakFree Premium" price automatically.
# STRIPE_PRICE_ID=price_...

# Optional: where the client is served, used for Stripe's return URLs.
# Set when the API and client are on different origins (e.g. local dev).
# APP_ORIGIN=http://localhost:5173

# OpenAI API key for the AI coach (real LLM). Leave unset to use offline mode.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
